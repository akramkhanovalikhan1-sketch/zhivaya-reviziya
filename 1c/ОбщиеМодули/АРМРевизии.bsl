// Серверные процедуры формы обработки АРМРуководителяРевизии.

Процедура НаправитьНаПерепроверку(НомерЗоны) Экспорт
	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Или Менеджер.Статус <> Перечисления.СтатусыЗонРевизии.Закрыта Тогда
		Возврат;
	КонецЕсли;
	Менеджер.ЗаблокированныйСотрудник = Менеджер.Сотрудник;
	Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Перепроверка;
	Менеджер.Записать();
КонецПроцедуры

Функция МожноФормироватьАкты() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА Сессии.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗонРевизии.Закрыта)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Закрыто
	|ИЗ
	|	РегистрСведений.СессииЗонРевизии КАК Сессии
	|ГДЕ
	|	Сессии.Карантин = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Всего > 0 И Выборка.Всего = Выборка.Закрыто;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция СравнениеСессий(НомерЗоны) Экспорт
	// Отчёт «Иванов vs Сидоров»: факт по номенклатуре сессии 1 и сессии 2.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Номенклатура КАК Номенклатура,
	|	История.НомерСессии КАК НомерСессии,
	|	История.Сотрудник КАК Сотрудник,
	|	СУММА(История.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.ИсторияСканированияТСД КАК История
	|ГДЕ
	|	История.НомерЗоны = &НомерЗоны
	|СГРУППИРОВАТЬ ПО
	|	История.Номенклатура,
	|	История.НомерСессии,
	|	История.Сотрудник";
	Запрос.УстановитьПараметр("НомерЗоны", НомерЗоны);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ЗаморозитьНоменклатуру(Номенклатура, Минут = 5) Экспорт
	// Блокировка выписки на кассах / заказах покупателей на время подсчёта паллеты.
	Менеджер = РегистрыСведений.ЗаморозкаНоменклатурыРевизии.СоздатьМенеджерЗаписи();
	Менеджер.Номенклатура = Номенклатура;
	Менеджер.ДействуетДо = ТекущаяДатаСеанса() + Минут * 60;
	Менеджер.Записать();
КонецПроцедуры

Функция ДанныеМонитора() Экспорт
	Зоны = Новый Массив;
	Рабочих = 0;
	Закрыто = 0;
	Серых = 0;
	Выборка = РегистрыСведений.СессииЗонРевизии.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Карантин Тогда
			Цвет = "gray";
			Статус = "idle";
		ИначеЕсли Выборка.Статус = Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
			Цвет = "yellow";
			Статус = "active";
			Рабочих = Рабочих + 1;
		ИначеЕсли Выборка.Статус = Перечисления.СтатусыЗонРевизии.Закрыта Тогда
			Цвет = "green";
			Статус = "closed";
			Рабочих = Рабочих + 1;
			Закрыто = Закрыто + 1;
		ИначеЕсли Выборка.Статус = Перечисления.СтатусыЗонРевизии.Перепроверка Тогда
			Цвет = "orange";
			Статус = "recheck";
			Рабочих = Рабочих + 1;
		Иначе
			Цвет = "gray";
			Статус = "idle";
			Рабочих = Рабочих + 1;
			Серых = Серых + 1;
		КонецЕсли;
		Зона = Новый Структура;
		Зона.Вставить("zoneId", Выборка.НомерЗоны);
		Зона.Вставить("name", "Зона " + Выборка.НомерЗоны);
		Зона.Вставить("status", Статус);
		Зона.Вставить("color", Цвет);
		Зона.Вставить("userName", Строка(Выборка.Сотрудник));
		Зона.Вставить("sessionNum", Выборка.НомерСессии);
		Зона.Вставить("startTime", XMLСтрока(Выборка.ВремяСтарта));
		Зона.Вставить("finishTime", XMLСтрока(Выборка.ВремяФиниша));
		Зона.Вставить("quarantine", Выборка.Карантин);
		Зоны.Добавить(Зона);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("canFinalize", Рабочих > 0 И Рабочих = Закрыто);
	Результат.Вставить("finalized", Ложь);
	Результат.Вставить("idleCount", Серых);
	Результат.Вставить("coveragePercent", ?(Рабочих = 0, 0, Окр(100 * Закрыто / Рабочих, 1)));
	Результат.Вставить("zones", Зоны);
	Результат.Вставить("lines", РасчетИтоговРевизии.СводныеСтроки());
	Результат.Вставить("candidates", Новый Массив);
	Результат.Вставить("autoOffset", Новый Массив);
	Результат.Вставить("transitWarnings", Новый Массив);
	Результат.Вставить("comparison", Новый Массив);
	Результат.Вставить("freezes", Новый Массив);
	Результат.Вставить("sales", Новый Массив);
	Результат.Вставить("acts", Новый Массив);
	Возврат Результат;
КонецФункции

Функция СформироватьАкты() Экспорт
	Если Не МожноФормироватьАкты() Тогда
		Возврат Новый Структура("ok, error, message, acts",
			Ложь, "not_ready", "Покрытие не 100%. Закройте все рабочие зоны.", Новый Массив);
	КонецЕсли;
	Акты = Новый Массив;
	Для Каждого Строка Из РасчетИтоговРевизии.СводныеСтроки() Цикл
		Отклонение = 0;
		Если Строка.Свойство("deviation") Тогда
			Отклонение = Строка.deviation;
		КонецЕсли;
		Если Отклонение = 0 Тогда
			Продолжить;
		КонецЕсли;
		Акт = Новый Структура;
		Акт.Вставить("sku", Строка.sku);
		Акт.Вставить("name", Строка.name);
		Акт.Вставить("qty", ?(Отклонение < 0, -Отклонение, Отклонение));
		Акт.Вставить("kind", ?(Отклонение < 0, "списание", "оприходование"));
		Акты.Добавить(Акт);
	КонецЦикла;
	// Айдын: здесь создать документы Оприходование / Списание по массиву Акты.
	Возврат Новый Структура("ok, acts, message", Истина, Акты, "Сформировано актов: " + Акты.Количество());
КонецФункции
