// Общий модуль РасчетИтоговРевизии
// Подключать из АРМ руководителя при обновлении таблицы и при формировании актов.

Функция ИтоговыйФакт(Номенклатура, НомерЗоны, НомерСессии) Экспорт
	ФактТСД = КоличествоПоТСД(Номенклатура, НомерЗоны, НомерСессии);
	ВремяСтарта = ВремяСтартаЗоны(НомерЗоны, НомерСессии);
	ПродажиПосле = ПродажиККМПосле(Номенклатура, ВремяСтарта);
	Возврат ФактТСД + ПродажиПосле;
КонецФункции

Функция КоличествоПоТСД(Номенклатура, НомерЗоны, НомерСессии)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(История.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.ИсторияСканированияТСД КАК История
	|ГДЕ
	|	История.Номенклатура = &Номенклатура
	|	И История.НомерЗоны = &НомерЗоны
	|	И История.НомерСессии = &НомерСессии";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НомерЗоны", НомерЗоны);
	Запрос.УстановитьПараметр("НомерСессии", НомерСессии);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество <> NULL Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция ВремяСтартаЗоны(НомерЗоны, НомерСессии)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сессии.ВремяСтарта КАК ВремяСтарта
	|ИЗ
	|	РегистрСведений.ИсторияСессийЗонРевизии КАК Сессии
	|ГДЕ
	|	Сессии.НомерЗоны = &НомерЗоны
	|	И Сессии.НомерСессии = &НомерСессии";
	Запрос.УстановитьПараметр("НомерЗоны", НомерЗоны);
	Запрос.УстановитьПараметр("НомерСессии", НомерСессии);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВремяСтарта;
	КонецЕсли;
	Возврат Дата(1, 1, 1);
КонецФункции

Функция ПродажиККМПосле(Номенклатура, ВремяСтарта)
	// Имя регистра продаж зависит от релиза Розницы:
	// Розница 2.3 — часто РегистрНакопления.Продажи / документы ЧекККМ.
	// Айдын: подставить фактические метаданные.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Товары.Количество) КАК Количество
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК Чек
	|		ПО Товары.Ссылка = Чек.Ссылка
	|ГДЕ
	|	Товары.Номенклатура = &Номенклатура
	|	И Чек.Проведен
	|	И Чек.Дата > &ВремяСтарта
	|	И НЕ Чек.Архивный";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ВремяСтарта", ВремяСтарта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество <> NULL Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Скользящее окно: для закрытой зоны продажи после финиша тоже плюсуются
// до завершения всей ревизии (пока не сформированы финальные акты).
Функция ПродажиДляЗакрытойЗоны(Номенклатура, ВремяСтарта, РевизияЗакрыта) Экспорт
	Если РевизияЗакрыта Тогда
		Возврат ПродажиККМПосле(Номенклатура, ВремяСтарта);
	КонецЕсли;
	Возврат ПродажиККМПосле(Номенклатура, ВремяСтарта);
КонецФункции
