// HTTP-сервис «ТСДРевизия», корневой URL: tsd
// Шаблоны URL:
//   auth        POST  /hs/tsd/auth
//   startZone   POST  /hs/tsd/startZone
//   scanItem    POST  /hs/tsd/scanItem
//   finishZone  POST  /hs/tsd/finishZone
//   dashboard   GET   /hs/tsd/arm/dashboard
//
// Публикация: Конфигуратор → Администрирование → Публикация на веб-сервере.
// CORS: если ТСД — браузер, включить заголовок Access-Control-Allow-Origin.

Функция AuthPOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	Штрихкод = СокрЛП(ЗначениеСвойства(Данные, "barcode"));

	Сотрудник = НайтиСотрудникаПоБейджу(Штрихкод);
	Если Сотрудник = Неопределено Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message",
			Ложь, "unknown_badge", "Бейдж не найден. Обратитесь к товароведу."));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("userId", XMLСтрока(Сотрудник));
	Результат.Вставить("userName", Строка(Сотрудник));
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция StartZonePOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессииВх = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));

	Сотрудник = СотрудникИзИдентификатора(ИдСотрудника);
	Если Сотрудник = Неопределено Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message", Ложь, "unknown_user", "Сотрудник не найден"));
	КонецЕсли;

	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();

	Перепроверка = Ложь;
	Предыдущий = "";
	Если Менеджер.Выбран() Тогда
		Если Менеджер.Статус = Перечисления.СтатусыЗонРевизии.ВРаботе
			И Менеджер.Сотрудник <> Сотрудник Тогда
			Возврат ОтветJSON(200, Новый Структура("ok, error, message",
				Ложь, "zone_busy", "Зону уже считает " + Строка(Менеджер.Сотрудник)));
		КонецЕсли;
		Если Менеджер.ЗаблокированныйСотрудник = Сотрудник Тогда
			Возврат ОтветJSON(200, Новый Структура("ok, error, message",
				Ложь, "recheck_blocked", "Первичный сотрудник заблокирован от этой зоны."));
		КонецЕсли;
		Перепроверка = (Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Закрыта
			Или Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Перепроверка);
		Предыдущий = Строка(Менеджер.Сотрудник);
	КонецЕсли;

	НомерСессии = ?(НомерСессииВх > 0, НомерСессииВх, ?(Менеджер.Выбран(), Менеджер.НомерСессии, 0) + 1);
	Если НомерСессии < 1 Тогда
		НомерСессии = 1;
	КонецЕсли;

	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.НомерСессии = НомерСессии;
	Менеджер.Сотрудник = Сотрудник;
	Менеджер.ВремяСтарта = ТекущаяДатаСеанса();
	Менеджер.ВремяФиниша = Дата(1, 1, 1);
	Менеджер.Статус = Перечисления.СтатусыЗонРевизии.ВРаботе;
	Менеджер.Записать();

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("zoneId", НомерЗоны);
	Результат.Вставить("zoneName", ПредставлениеЗоны(НомерЗоны));
	Результат.Вставить("sessionNum", НомерСессии);
	Результат.Вставить("startTime", XMLСтрока(Менеджер.ВремяСтарта));
	Результат.Вставить("recheck", Перепроверка);
	Результат.Вставить("previousUserName", Предыдущий);
	Если Перепроверка Тогда
		Результат.Вставить("message",
			"Внимание, перепроверка! Аннулировать первый подсчет (" + Предыдущий + ")?");
	Иначе
		Результат.Вставить("message", "");
	КонецЕсли;
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция ScanItemPOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	Штрихкод = СокрЛП(ЗначениеСвойства(Данные, "barcode"));
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	Количество = ЧислоИзJSON(ЗначениеСвойства(Данные, "qty"));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессии = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));
	ИдТСД = СокрЛП(ЗначениеСвойства(Данные, "deviceId"));

	Сессия = ТекущаяСессияЗоны(НомерЗоны);
	Если Сессия = Неопределено Или Сессия.Статус <> Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, alarm, error, message",
			Ложь, Истина, "zone_not_started", "Сначала нажмите НАЧАТЬ ПОДСЧЕТ"));
	КонецЕсли;
	Если Сессия.НомерСессии <> НомерСессии Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, alarm, error, message",
			Ложь, Истина, "session_mismatch", "Сессия зоны устарела"));
	КонецЕсли;

	Товар = НайтиНоменклатуруПоШтрихкоду(Штрихкод);
	Если Товар = Неопределено Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, alarm, error, message",
			Ложь, Истина, "unknown_barcode", "Штрихкод неизвестен"));
	КонецЕсли;

	ЭтоДубль = Ложь;
	ОсновнойТовар = ОсновнаяКарточкаАналога(Товар, ЭтоДубль);

	Запись = РегистрыСведений.ИсторияСканированияТСД.СоздатьМенеджерЗаписи();
	Запись.МоментВремени = ТекущаяДатаСеанса();
	Запись.ИдЗаписи = Новый УникальныйИдентификатор;
	Запись.ИдентификаторТСД = ИдТСД;
	Запись.Сотрудник = СотрудникИзИдентификатора(ИдСотрудника);
	Запись.НомерЗоны = НомерЗоны;
	Запись.НомерСессии = НомерСессии;
	Запись.Номенклатура = ОсновнойТовар;
	Запись.Количество = Количество;
	Запись.СчитанныйШтрихкод = Штрихкод;
	Запись.Записать();

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("alarm", Ложь);
	Результат.Вставить("name", Строка(ОсновнойТовар));
	Результат.Вставить("sku", КодНоменклатуры(ОсновнойТовар));
	Результат.Вставить("qty", Количество);
	Если ЭтоДубль Тогда
		Результат.Вставить("warning", "duplicate_card");
		Результат.Вставить("message",
			"Это дубликат. Считаем в общую кучу к Основному товару: " + Строка(ОсновнойТовар));
	Иначе
		Результат.Вставить("warning", "");
		Результат.Вставить("message", "");
	КонецЕсли;
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция FinishZonePOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессии = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));

	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Или Менеджер.Статус <> Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message", Ложь, "not_active", "Зона не в работе"));
	КонецЕсли;
	Если XMLСтрока(Менеджер.Сотрудник) <> ИдСотрудника Или Менеджер.НомерСессии <> НомерСессии Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message", Ложь, "session_mismatch", "Чужая сессия"));
	КонецЕсли;

	Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Закрыта;
	Менеджер.ВремяФиниша = ТекущаяДатаСеанса();
	Менеджер.Записать();
	Возврат ОтветJSON(200, Новый Структура("ok, message", Истина, "Зона закрыта"));
КонецФункции

#Область Служебные

Функция ПрочитатьТело(Запрос)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	Возврат ПрочитатьJSON(Чтение, Ложь);
КонецФункции

Функция ОтветJSON(Код, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ЗначениеСвойства(Данные, Имя)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЧислоИзJSON(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция НайтиСотрудникаПоБейджу(Штрихкод)
	// Привязка: регистр сведений ШтрихкодыНоменклатуры / доп. реквизит сотрудника / справочник ФизическиеЛица.
	// Айдын: заменить на фактический поиск по конфигурации «1С:Розница».
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Код = &Код
	|	И НЕ Сотрудники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", Штрихкод);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СотрудникИзИдентификатора(Ид)
	Попытка
		Возврат XMLЗначение(Тип("СправочникСсылка.ФизическиеЛица"), Ид);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция НайтиНоменклатуруПоШтрихкоду(Штрихкод)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Номенклатура;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОсновнаяКарточкаАналога(Товар, ЭтоДубль)
	ЭтоДубль = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Группы.ОсновнаяНоменклатура КАК Основная
	|ИЗ
	|	РегистрСведений.ГруппыАналоговНоменклатуры КАК Группы
	|ГДЕ
	|	Группы.Номенклатура = &Товар
	|	И Группы.ОсновнаяНоменклатура <> &Товар";
	Запрос.УстановитьПараметр("Товар", Товар);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ЭтоДубль = Истина;
		Возврат Результат.Основная;
	КонецЕсли;
	Возврат Товар;
КонецФункции

Функция ТекущаяСессияЗоны(НомерЗоны)
	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Возврат Менеджер;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПредставлениеЗоны(НомерЗоны)
	Возврат "Зона " + НомерЗоны;
КонецФункции

Функция КодНоменклатуры(Номенклатура)
	Возврат СокрЛП(Номенклатура.Код);
КонецФункции

#КонецОбласти
