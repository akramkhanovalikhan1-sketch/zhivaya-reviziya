// HTTP-сервис «ТСДРевизия», корневой URL: tsd
// Шаблоны URL:
//   auth        POST  /hs/tsd/auth
//   startZone   POST  /hs/tsd/startZone
//   scanItem    POST  /hs/tsd/scanItem
//   finishZone    POST  /hs/tsd/finishZone
//   sessionLines  GET   /hs/tsd/sessionLines
//   undoLast      POST  /hs/tsd/undoLast
//   ping          GET   /hs/tsd/ping
//   zones         GET   /hs/tsd/zones
//   dashboard     GET   /hs/tsd/arm/dashboard
//   closeIdle     POST  /hs/tsd/arm/closeIdle
//   recheck       POST  /hs/tsd/arm/recheck
//   OPTIONS на каждый шаблон → CORSOPTIONS
//
// Публикация: Конфигуратор → Администрирование → Публикация на веб-сервере.
// CORS: если ТСД — браузер, включить заголовок Access-Control-Allow-Origin.

Функция AuthPOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	Штрихкод = СокрЛП(ЗначениеСвойства(Данные, "barcode"));

	Сотрудник = НайтиСотрудникаПоБейджу(Штрихкод);
	Если Сотрудник = Неопределено Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message",
			Ложь, "unknown_badge", "Бейдж не найден. Обратитесь к товароведу."));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("userId", XMLСтрока(Сотрудник));
	Результат.Вставить("userName", Строка(Сотрудник));
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция StartZonePOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессииВх = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));

	Сотрудник = СотрудникИзИдентификатора(ИдСотрудника);
	Если Сотрудник = Неопределено Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message", Ложь, "unknown_user", "Сотрудник не найден"));
	КонецЕсли;

	Если НомерЗоны = "Q-RC" Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message",
			Ложь, "quarantine", "Зона карантина РЦ. ТСД сюда не заходят до конца ревизии (правило cut-off)."));
	КонецЕсли;

	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();

	Перепроверка = Ложь;
	Предыдущий = "";
	Если Менеджер.Выбран() Тогда
		Если Менеджер.Карантин Тогда
			Возврат ОтветJSON(200, Новый Структура("ok, error, message",
				Ложь, "quarantine", "Зона карантина РЦ. ТСД сюда не заходят до конца ревизии (правило cut-off)."));
		КонецЕсли;
		Если Менеджер.Статус = Перечисления.СтатусыЗонРевизии.ВРаботе
			И Менеджер.Сотрудник <> Сотрудник Тогда
			Возврат ОтветJSON(200, Новый Структура("ok, error, message",
				Ложь, "zone_busy", "Зону уже считает " + Строка(Менеджер.Сотрудник)));
		КонецЕсли;
		Если Менеджер.ЗаблокированныйСотрудник = Сотрудник Тогда
			Возврат ОтветJSON(200, Новый Структура("ok, error, message",
				Ложь, "recheck_blocked", "Первичный сотрудник заблокирован от этой зоны."));
		КонецЕсли;
		Перепроверка = (Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Закрыта
			Или Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Перепроверка);
		Предыдущий = Строка(Менеджер.Сотрудник);
	КонецЕсли;

	Подтверждено = БулевоИзJSON(ЗначениеСвойства(Данные, "confirmRecheck"));
	Если Перепроверка И Не Подтверждено Тогда
		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("needsConfirm", Истина);
		Результат.Вставить("recheck", Истина);
		Результат.Вставить("zoneId", НомерЗоны);
		Результат.Вставить("zoneName", ПредставлениеЗоны(НомерЗоны));
		Результат.Вставить("sessionNum", ?(Менеджер.Выбран(), Менеджер.НомерСессии, 0));
		Результат.Вставить("startTime", ?(Менеджер.Выбран(), XMLСтрока(Менеджер.ВремяСтарта), ""));
		Результат.Вставить("previousUserName", Предыдущий);
		Результат.Вставить("message",
			"Внимание, перепроверка! Аннулировать первый подсчет (" + Предыдущий + ")?");
		Возврат ОтветJSON(200, Результат);
	КонецЕсли;

	НомерСессии = ?(НомерСессииВх > 0, НомерСессииВх, ?(Менеджер.Выбран(), Менеджер.НомерСессии, 0) + 1);
	Если НомерСессии < 1 Тогда
		НомерСессии = 1;
	КонецЕсли;

	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.НомерСессии = НомерСессии;
	Менеджер.Сотрудник = Сотрудник;
	Менеджер.ВремяСтарта = ТекущаяДатаСеанса();
	Менеджер.ВремяФиниша = Дата(1, 1, 1);
	Менеджер.Статус = Перечисления.СтатусыЗонРевизии.ВРаботе;
	Менеджер.Записать();
	ЗаписатьИсториюСессии(Менеджер);

	НоменклатураПаллеты = НоменклатураЗаморозкиЗоны(НомерЗоны);
	Если НоменклатураПаллеты <> Неопределено Тогда
		АРМРевизии.ЗаморозитьНоменклатуру(НоменклатураПаллеты, 5);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("zoneId", НомерЗоны);
	Результат.Вставить("zoneName", ПредставлениеЗоны(НомерЗоны));
	Результат.Вставить("sessionNum", НомерСессии);
	Результат.Вставить("startTime", XMLСтрока(Менеджер.ВремяСтарта));
	Результат.Вставить("recheck", Перепроверка);
	Результат.Вставить("previousUserName", Предыдущий);
	Если Перепроверка Тогда
		Результат.Вставить("message",
			"Внимание, перепроверка! Аннулировать первый подсчет (" + Предыдущий + ")?");
	Иначе
		Результат.Вставить("message", "");
	КонецЕсли;
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция ScanItemPOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	Штрихкод = СокрЛП(ЗначениеСвойства(Данные, "barcode"));
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	Количество = ЧислоИзJSON(ЗначениеСвойства(Данные, "qty"));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессии = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));
	ИдТСД = СокрЛП(ЗначениеСвойства(Данные, "deviceId"));

	Сессия = ТекущаяСессияЗоны(НомерЗоны);
	Если Сессия = Неопределено Или Сессия.Статус <> Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, alarm, error, message",
			Ложь, Истина, "zone_not_started", "Сначала нажмите НАЧАТЬ ПОДСЧЕТ"));
	КонецЕсли;
	Если Сессия.НомерСессии <> НомерСессии Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, alarm, error, message",
			Ложь, Истина, "session_mismatch", "Сессия зоны устарела"));
	КонецЕсли;

	Товар = НайтиНоменклатуруПоШтрихкоду(Штрихкод);
	Если Товар = Неопределено Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, alarm, error, message",
			Ложь, Истина, "unknown_barcode", "Штрихкод неизвестен"));
	КонецЕсли;

	ЭтоДубль = Ложь;
	ОсновнойТовар = ОсновнаяКарточкаАналога(Товар, ЭтоДубль);

	Запись = РегистрыСведений.ИсторияСканированияТСД.СоздатьМенеджерЗаписи();
	Запись.МоментВремени = ТекущаяДатаСеанса();
	Запись.ИдЗаписи = Новый УникальныйИдентификатор;
	Запись.ИдентификаторТСД = ИдТСД;
	Запись.Сотрудник = СотрудникИзИдентификатора(ИдСотрудника);
	Запись.НомерЗоны = НомерЗоны;
	Запись.НомерСессии = НомерСессии;
	Запись.Номенклатура = ОсновнойТовар;
	Запись.Количество = Количество;
	Запись.СчитанныйШтрихкод = Штрихкод;
	Запись.Записать();

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("alarm", Ложь);
	Результат.Вставить("name", Строка(ОсновнойТовар));
	Результат.Вставить("sku", КодНоменклатуры(ОсновнойТовар));
	Результат.Вставить("qty", Количество);
	Если ЭтоДубль Тогда
		Результат.Вставить("warning", "duplicate_card");
		Результат.Вставить("message",
			"Это дубликат. Считаем в общую кучу к Основному товару: " + Строка(ОсновнойТовар));
	Иначе
		Результат.Вставить("warning", "");
		Результат.Вставить("message", "");
	КонецЕсли;
	Результат.Вставить("lines", СтрокиСессии(НомерЗоны, НомерСессии));
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция FinishZonePOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессии = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));

	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Или Менеджер.Статус <> Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message", Ложь, "not_active", "Зона не в работе"));
	КонецЕсли;
	Если XMLСтрока(Менеджер.Сотрудник) <> ИдСотрудника Или Менеджер.НомерСессии <> НомерСессии Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message", Ложь, "session_mismatch", "Чужая сессия"));
	КонецЕсли;

	Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Закрыта;
	Менеджер.ВремяФиниша = ТекущаяДатаСеанса();
	Менеджер.Записать();
	ЗаписатьИсториюСессии(Менеджер);

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("zoneId", НомерЗоны);
	Результат.Вставить("zoneName", ПредставлениеЗоны(НомерЗоны));
	Результат.Вставить("sessionNum", НомерСессии);
	Результат.Вставить("lines", СтрокиСессии(НомерЗоны, НомерСессии));
	Результат.Вставить("message", "Зона закрыта. Виртуальный замок включён.");
	Возврат ОтветJSON(200, Результат);
КонецФункции

Функция PingGET(Запрос)
	Возврат ОтветJSON(200, Новый Структура("ok, time", Истина, XMLСтрока(ТекущаяДатаСеанса())));
КонецФункции

Функция ZonesGET(Запрос)
	Зоны = Новый Массив;
	Выборка = РегистрыСведений.СессииЗонРевизии.Выбрать();
	Пока Выборка.Следующий() Цикл
		Статус = "idle";
		Если Выборка.Статус = Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
			Статус = "active";
		ИначеЕсли Выборка.Статус = Перечисления.СтатусыЗонРевизии.Закрыта Тогда
			Статус = "closed";
		ИначеЕсли Выборка.Статус = Перечисления.СтатусыЗонРевизии.Перепроверка Тогда
			Статус = "recheck";
		КонецЕсли;
		Зона = Новый Структура;
		Зона.Вставить("zoneId", Выборка.НомерЗоны);
		Зона.Вставить("name", ПредставлениеЗоны(Выборка.НомерЗоны));
		Зона.Вставить("status", Статус);
		Зона.Вставить("quarantine", Выборка.Карантин);
		Зоны.Добавить(Зона);
	КонецЦикла;
	Возврат ОтветJSON(200, Новый Структура("ok, zones", Истина, Зоны));
КонецФункции

Функция SessionLinesGET(Запрос)
	НомерЗоны = ВРег(СокрЛП(Запрос.ПараметрыЗапроса.Получить("zoneId")));
	НомерСессии = ЧислоИзJSON(Запрос.ПараметрыЗапроса.Получить("sessionNum"));
	Сессия = ТекущаяСессияЗоны(НомерЗоны);
	Если Сессия = Неопределено Или Сессия.Статус <> Перечисления.СтатусыЗонРевизии.ВРаботе
		Или Сессия.НомерСессии <> НомерСессии Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message, lines",
			Ложь, "session_mismatch", "Сессия зоны устарела", Новый Массив));
	КонецЕсли;
	Возврат ОтветJSON(200, Новый Структура("ok, lines", Истина, СтрокиСессии(НомерЗоны, НомерСессии)));
КонецФункции

Функция UndoLastPOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	ИдСотрудника = СокрЛП(ЗначениеСвойства(Данные, "userId"));
	НомерСессии = ЧислоИзJSON(ЗначениеСвойства(Данные, "sessionNum"));
	Сессия = ТекущаяСессияЗоны(НомерЗоны);
	Если Сессия = Неопределено Или Сессия.Статус <> Перечисления.СтатусыЗонРевизии.ВРаботе Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message, lines",
			Ложь, "zone_not_started", "Зона не в работе", Новый Массив));
	КонецЕсли;

	ЗапросПоиска = Новый Запрос;
	ЗапросПоиска.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	История.МоментВремени КАК МоментВремени,
	|	История.ИдЗаписи КАК ИдЗаписи
	|ИЗ
	|	РегистрСведений.ИсторияСканированияТСД КАК История
	|ГДЕ
	|	История.НомерЗоны = &НомерЗоны
	|	И История.НомерСессии = &НомерСессии
	|УПОРЯДОЧИТЬ ПО
	|	История.МоментВремени УБЫВ";
	ЗапросПоиска.УстановитьПараметр("НомерЗоны", НомерЗоны);
	ЗапросПоиска.УстановитьПараметр("НомерСессии", НомерСессии);
	Выборка = ЗапросПоиска.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат ОтветJSON(200, Новый Структура("ok, error, message, lines",
			Ложь, "empty", "Нет скана для отмены", Новый Массив));
	КонецЕсли;

	Набор = РегистрыСведений.ИсторияСканированияТСД.СоздатьНаборЗаписей();
	Набор.Отбор.МоментВремени.Установить(Выборка.МоментВремени);
	Набор.Отбор.ИдЗаписи.Установить(Выборка.ИдЗаписи);
	Набор.Записать();
	Возврат ОтветJSON(200, Новый Структура("ok, lines", Истина, СтрокиСессии(НомерЗоны, НомерСессии)));
КонецФункции

Функция CloseIdlePOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	Закрыто = 0;
	Если ЗначениеЗаполнено(НомерЗоны) Тогда
		Если ЗакрытьПустуюЗону(НомерЗоны) Тогда
			Закрыто = 1;
		КонецЕсли;
	Иначе
		Выборка = РегистрыСведений.СессииЗонРевизии.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗакрытьПустуюЗону(Выборка.НомерЗоны) Тогда
				Закрыто = Закрыто + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ОтветJSON(200, Новый Структура("ok, closed, message", Истина, Закрыто, "Закрыто пустых зон: " + Закрыто));
КонецФункции

Функция RecheckPOST(Запрос)
	Данные = ПрочитатьТело(Запрос);
	НомерЗоны = ВРег(СокрЛП(ЗначениеСвойства(Данные, "zoneId")));
	АРМРевизии.НаправитьНаПерепроверку(НомерЗоны);
	Возврат ОтветJSON(200, Новый Структура("ok, message", Истина, "Зона направлена на перепроверку"));
КонецФункции

Функция DashboardGET(Запрос)
	Возврат ОтветJSON(200, АРМРевизии.ДанныеМонитора());
КонецФункции

Функция CORSOPTIONS(Запрос)
	Ответ = Новый HTTPСервисОтвет(204);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type");
	Возврат Ответ;
КонецФункции

#Область Служебные

Функция ПрочитатьТело(Запрос)
	Текст = Запрос.ПолучитьТелоКакСтроку();
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Ложь);
КонецФункции

Функция ОтветJSON(Код, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ЗначениеСвойства(Данные, Имя)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЧислоИзJSON(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция БулевоИзJSON(Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ВРег(СокрЛП(Значение)) = "TRUE" Или Значение = "1";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ЗаписатьИсториюСессии(Менеджер)
	Запись = РегистрыСведений.ИсторияСессийЗонРевизии.СоздатьМенеджерЗаписи();
	Запись.НомерЗоны = Менеджер.НомерЗоны;
	Запись.НомерСессии = Менеджер.НомерСессии;
	Запись.Сотрудник = Менеджер.Сотрудник;
	Запись.ВремяСтарта = Менеджер.ВремяСтарта;
	Запись.ВремяФиниша = Менеджер.ВремяФиниша;
	Запись.Статус = Менеджер.Статус;
	Запись.Записать();
КонецПроцедуры

Функция НоменклатураЗаморозкиЗоны(НомерЗоны)
	// Паллеты цемента / кирпича — 5 минут с момента StartZone.
	// Айдын: заменить на справочник зон или доп. реквизит.
	Если НомерЗоны = "P-01" Или НомерЗоны = "P-02" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиСотрудникаПоБейджу(Штрихкод)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Сотрудники
	|ГДЕ
	|	(Сотрудники.Код = &Код Или Сотрудники.Наименование = &Код)
	|	И НЕ Сотрудники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", Штрихкод);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СотрудникИзИдентификатора(Ид)
	Попытка
		Возврат XMLЗначение(Тип("СправочникСсылка.ФизическиеЛица"), Ид);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция НайтиНоменклатуруПоШтрихкоду(Штрихкод)
	Найден = НайтиПоРегиструШтрихкодов("РегистрСведений.Штрихкоды", Штрихкод);
	Если Найден <> Неопределено Тогда
		Возврат Найден;
	КонецЕсли;
	Возврат НайтиПоРегиструШтрихкодов("РегистрСведений.ШтрихкодыНоменклатуры", Штрихкод);
КонецФункции

Функция НайтиПоРегиструШтрихкодов(ИмяРегистра, Штрихкод)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Номенклатура КАК Номенклатура
	|ИЗ
	|	" + ИмяРегистра + " КАК Т
	|ГДЕ
	|	Т.Штрихкод = &Штрихкод";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Попытка
		Результат = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Результат.Следующий() Тогда
		Возврат Результат.Номенклатура;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОсновнаяКарточкаАналога(Товар, ЭтоДубль)
	ЭтоДубль = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Группы.ОсновнаяНоменклатура КАК Основная
	|ИЗ
	|	РегистрСведений.ГруппыАналоговНоменклатуры КАК Группы
	|ГДЕ
	|	Группы.Номенклатура = &Товар
	|	И Группы.ОсновнаяНоменклатура <> &Товар";
	Запрос.УстановитьПараметр("Товар", Товар);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ЭтоДубль = Истина;
		Возврат Результат.Основная;
	КонецЕсли;
	Возврат Товар;
КонецФункции

Функция ТекущаяСессияЗоны(НомерЗоны)
	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		Возврат Менеджер;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПредставлениеЗоны(НомерЗоны)
	Возврат "Зона " + НомерЗоны;
КонецФункции

Функция КодНоменклатуры(Номенклатура)
	Возврат СокрЛП(Номенклатура.Код);
КонецФункции

Функция СтрокиСессии(НомерЗоны, НомерСессии)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Номенклатура КАК Номенклатура,
	|	СУММА(История.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.ИсторияСканированияТСД КАК История
	|ГДЕ
	|	История.НомерЗоны = &НомерЗоны
	|	И История.НомерСессии = &НомерСессии
	|СГРУППИРОВАТЬ ПО
	|	История.Номенклатура";
	Запрос.УстановитьПараметр("НомерЗоны", НомерЗоны);
	Запрос.УстановитьПараметр("НомерСессии", НомерСессии);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультат = Новый Структура;
		СтрокаРезультат.Вставить("sku", КодНоменклатуры(Выборка.Номенклатура));
		СтрокаРезультат.Вставить("name", Строка(Выборка.Номенклатура));
		СтрокаРезультат.Вставить("qty", Выборка.Количество);
		Строки.Добавить(СтрокаРезультат);
	КонецЦикла;
	Возврат Строки;
КонецФункции

Функция ЗакрытьПустуюЗону(НомерЗоны)
	Менеджер = РегистрыСведений.СессииЗонРевизии.СоздатьМенеджерЗаписи();
	Менеджер.НомерЗоны = НомерЗоны;
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Тогда
		Менеджер.НомерЗоны = НомерЗоны;
		Менеджер.НомерСессии = 1;
		Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Закрыта;
		Менеджер.ВремяФиниша = ТекущаяДатаСеанса();
		Менеджер.Записать();
		Возврат Истина;
	КонецЕсли;
	Если Менеджер.Карантин Или Менеджер.Статус <> Перечисления.СтатусыЗонРевизии.Свободна Тогда
		Возврат Ложь;
	КонецЕсли;
	Менеджер.Статус = Перечисления.СтатусыЗонРевизии.Закрыта;
	Менеджер.ВремяФиниша = ТекущаяДатаСеанса();
	Менеджер.Записать();
	Возврат Истина;
КонецФункции

#КонецОбласти
